local function createDiscordRow(parent, yPos, title, link)
	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, yPos),
		Size = UDim2.new(1, -60, 0, 24),
		ZIndex = 8,
		FontFace = FONT_HEAVY,
		Text = title,
		TextColor3 = WHITE,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)

	local copyBtn = makeButton(parent, "COPY", UDim2.new(1, -50, 0, yPos), UDim2.new(0, 50, 0, 24))
	copyBtn.TextSize = 10
	copyBtn.MouseButton1Click:Connect(function()
		if setclipboard then
			setclipboard(link)
			copyBtn.Text = "COPIED"
			task.delay(1.5, function() copyBtn.Text = "COPY" end)
		end
	end)
end

createDiscordRow(SettingsPage, 142, "VIPER DISCORD", "https://discord.gg/ZvGZNsHRTn")
createDiscordRow(SettingsPage, 172, "NEBULA DISCORD", "https://discord.gg/FHXytRrzAq")

-- THEMES PAGE
