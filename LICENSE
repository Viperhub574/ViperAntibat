repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local env = (type(getgenv) == "function" and getgenv()) or _G

pcall(function()
	for _, n in ipairs({"ViperXNebulaAntiBatUI"}) do
		local old = PlayerGui:FindFirstChild(n)
		if old then old:Destroy() end
		local oldCore = game:GetService("CoreGui"):FindFirstChild(n)
		if oldCore then oldCore:Destroy() end
	end
end)
pcall(function()
	local prev = env.__VIPER_NEBULA_ANTIBAT_RUNTIME
	if type(prev) == "table" and type(prev.destroy) == "function" then prev.destroy() end
end)

local runtime = { alive = true }
env.__VIPER_NEBULA_ANTIBAT_RUNTIME = runtime
local conns = {}
local function track(c)
	table.insert(conns, c)
	return c
end

local INF_JUMP_SPEED = 50
local SLIDER_MIN, SLIDER_MAX = 50, 150

local state = {
	AntiBat = false,
	InfJump = false,
	Scale = 100,
	Opacity = 40,
}
local antiTpKey = nil
local bindingKey = false
local currentPage = "Main"
local isMinimized = false

