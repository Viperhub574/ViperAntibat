    Name = "ThemePage",
    BackgroundTransparency = 1,
    BorderSizePixel = 0,
    Position = UDim2.new(0, 12, 0, 40),
    Size = UDim2.new(1, -24, 1, -40),
    Visible = false,
    ZIndex = 5,
}, Panel)

