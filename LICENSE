end
local DEFAULT_BG = THEMES[1].image

-- [ AYARLARI KAYDETME VE YÜKLEME SİSTEMİ ] --
local SETTINGS_FILE = "ViperXNebula_Settings.json"

local function saveSettings()
    if not writefile then return end
    local data = {
        Scale = state.Scale,
        Opacity = state.Opacity,
        Keybind = antiTpKey and antiTpKey.Name or "NONE",
        Background = DEFAULT_BG
    }
    pcall(function() writefile(SETTINGS_FILE, HttpService:JSONEncode(data)) end)
end

local function loadSettings()
    if not readfile or not isfile or not isfile(SETTINGS_FILE) then return end
    pcall(function()
        local data = HttpService:JSONDecode(readfile(SETTINGS_FILE))
        if data.Scale then state.Scale = data.Scale end
        if data.Opacity then state.Opacity = data.Opacity end
        if data.Keybind then 
            if data.Keybind == "NONE" then
                antiTpKey = nil
            else
                pcall(function() antiTpKey = Enum.KeyCode[data.Keybind] end)
            end
        end
        if data.Background then DEFAULT_BG = data.Background end
    end)
end

loadSettings() 

local VS_FAKE = 16
local spoofedVelocity = Vector3.zero

local function isSpoofTarget(self)
	if typeof(self) ~= "Instance" then return false end
	if not self:IsA("BasePart") then return false end
	local char = LocalPlayer.Character
	if not char then return false end
	return self == char:FindFirstChild("HumanoidRootPart") or self:IsDescendantOf(char)
end

pcall(function()
	if not (getrawmetatable and setreadonly and newcclosure and checkcaller) then return end
	local mt = getrawmetatable(game)
	setreadonly(mt, false)
	local oldIndex = mt.__index
	local oldNewIndex = mt.__newindex

	mt.__index = newcclosure(function(self, key)
		if state.AntiBat and not checkcaller() and (key == "AssemblyLinearVelocity" or key == "Velocity") then
			if isSpoofTarget(self) then
				return spoofedVelocity
			end
		end
		return oldIndex(self, key)
	end)

	mt.__newindex = newcclosure(function(self, key, value)
		if state.AntiBat and not checkcaller() and (key == "AssemblyLinearVelocity" or key == "Velocity") then
			if isSpoofTarget(self) then
				return
			end
		end
		return oldNewIndex(self, key, value)
	end)
	setreadonly(mt, true)
end)

local function updateFakeVelocity()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not hum or not root or hum.Health <= 0 then return end
	local dir = hum.MoveDirection
	if dir.Magnitude > 0.05 then
		local unit = dir.Unit
		spoofedVelocity = Vector3.new(unit.X * VS_FAKE, root.AssemblyLinearVelocity.Y, unit.Z * VS_FAKE)
	else
		spoofedVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
	end
end
track((RunService.PreSimulation or RunService.Stepped):Connect(updateFakeVelocity))

local Speed = 15000
local Angle = 0
local Direction = 1

local currentCarryWeld = nil
local currentBrainrotPart = nil
local currentCharacterPart = nil

local function getSafeY(root)
	local y = root.AssemblyLinearVelocity.Y
	if not UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		if y > 20 then
			y = 0
		elseif y < -45 then
			y = -45
		end
	end
	return y
end

local function antiBatStep()
	if not state.AntiBat then return end
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not root.Parent or not hum or hum.Health <= 0 then return end

	local origVel = root.AssemblyLinearVelocity
	local origXZ = Vector3.new(origVel.X, 0, origVel.Z)
	local safeY = getSafeY(root)

	Speed = Speed + (90 * Direction)
	if Speed >= 22000 then
		Speed = 22000
		Direction = -1
	elseif Speed <= 12000 then
		Speed = 12000
		Direction = 1
	end

	Angle = Angle + (math.random() * 0.7 + 0.35)
	local radius = Speed + math.random(-4500, 4500)
	local newX = math.cos(Angle) * radius
	local newZ = math.sin(Angle) * radius

	root.AssemblyLinearVelocity = Vector3.new(newX, safeY, newZ)
	pcall(function() root.Velocity = Vector3.new(newX, safeY, newZ) end)
	root.AssemblyAngularVelocity = Vector3.zero

	RunService.RenderStepped:Wait()

	if root and root.Parent then
		local curY = root.AssemblyLinearVelocity.Y
		root.AssemblyLinearVelocity = Vector3.new(origXZ.X, curY, origXZ.Z)
		pcall(function() root.Velocity = Vector3.new(origXZ.X, curY, origXZ.Z) end)
	end
end

local function setupHumanoidProtections(hum)
	if not hum then return end
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
	end)
end

local function isRealBrainrot(child)
	if not child or not child.Parent then return false end
	local n = child.Name:lower()
	if child:IsA("Model") or child:IsA("Folder") then
		if n:find("brainrot") or n:find("stolen") or n:find("carry") or n:find("animal") or child:GetAttribute("Brainrot") == true then
			return true
		end
	elseif child:IsA("BasePart") then
		if (n:find("brainrot") or n:find("stolen") or child:GetAttribute("Brainrot") == true) and not n:find("root") and not n:find("torso") and not n:find("arm") and not n:find("leg") and not n:find("head") then
			return true
		end
	elseif child:IsA("Tool") then
		if (n:find("brainrot") or child:GetAttribute("Brainrot") == true) and not (n:find("bat") or n:find("slap") or n:find("punch") or n:find("fist") or n:find("medusa") or n:find("gun") or n:find("sword") or n:find("potion") or n:find("speed") or n:find("taser") or n:find("shield") or n:find("bomb") or n:find("knife")) then
			return true
		end
	end
	return false
end

local function preserveCarryWeld(char)
	if not char then return end
	local targetBrainrot = nil
	for _, child in ipairs(char:GetChildren()) do
		if isRealBrainrot(child) then
			targetBrainrot = child
			break
		end
	end

	if not targetBrainrot then
		currentBrainrotPart = nil
		currentCharacterPart = nil
		if currentCarryWeld and currentCarryWeld.Name == "ViperCarryProtectionWeld" then
			pcall(function() currentCarryWeld:Destroy() end)
		end
		currentCarryWeld = nil
		return
	end

	local rootTarget = targetBrainrot:IsA("Tool") and (targetBrainrot:FindFirstChild("Handle") or targetBrainrot:FindFirstChildWhichIsA("BasePart")) or (targetBrainrot:FindFirstChild("RootPart") or targetBrainrot:FindFirstChild("HumanoidRootPart") or targetBrainrot:FindFirstChildWhichIsA("BasePart"))
	if not rootTarget then return end

	currentBrainrotPart = rootTarget
	currentCharacterPart = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	if not currentCharacterPart then return end

	for _, p in ipairs(targetBrainrot:GetDescendants()) do
		if p:IsA("BasePart") then
			if p.CanCollide then p.CanCollide = false end
			if not p.Massless then p.Massless = true end
			p.CustomPhysicalProperties = PhysicalProperties.new(0.001, 0, 0, 0, 0)
		end
	end

	local hasActiveWeld = false
	for _, w in ipairs(char:GetDescendants()) do
		if w:IsA("WeldConstraint") or w:IsA("ManualWeld") or w:IsA("Weld") or w:IsA("Motor6D") then
			if (w.Part0 == currentCharacterPart and w.Part1 == currentBrainrotPart) or (w.Part1 == currentCharacterPart and w.Part0 == currentBrainrotPart) then
				if not w.Enabled then w.Enabled = true end
				hasActiveWeld = true
				currentCarryWeld = w
				break
			end
		end
	end

	if not hasActiveWeld then
		local newWeld = Instance.new("WeldConstraint")
		newWeld.Name = "ViperCarryProtectionWeld"
		newWeld.Part0 = currentCharacterPart
		newWeld.Part1 = currentBrainrotPart
		newWeld.Parent = currentCharacterPart
		currentCarryWeld = newWeld
	end
end

local function antiRagdollStep()
	if not state.AntiBat then return end
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if hum and hum.Health > 0 then
		local st = hum:GetState()
		if st == Enum.HumanoidStateType.Physics
			or st == Enum.HumanoidStateType.Ragdoll
			or st == Enum.HumanoidStateType.FallingDown
			or st == Enum.HumanoidStateType.PlatformStanding
			or hum.PlatformStand
			or hum.Sit then
			hum.PlatformStand = false
			hum.Sit = false
			hum:ChangeState(Enum.HumanoidStateType.Running)
			workspace.CurrentCamera.CameraSubject = hum
			pcall(function()
				local pm = LocalPlayer.PlayerScripts:FindFirstChild("PlayerModule")
				if pm then require(pm:FindFirstChild("ControlModule")):Enable() end
			end)
			if root then
				root.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end

	for _, obj in ipairs(char:GetDescendants()) do
		if obj:IsA("BallSocketConstraint") or (obj:IsA("Attachment") and obj.Name:find("RagdollAttachment")) then
			pcall(function() obj:Destroy() end)
		elseif obj:IsA("Motor6D") and not obj.Enabled then
			obj.Enabled = true
		end
	end

	pcall(function() preserveCarryWeld(char) end)
end

local function hookCharacter(char)
	if not char then return end
	local hum = char:WaitForChild("Humanoid", 5)
	if hum then
		setupHumanoidProtections(hum)
		track(hum.StateChanged:Connect(function(oldState, newState)
			if state.AntiBat then
				if newState == Enum.HumanoidStateType.Physics
					or newState == Enum.HumanoidStateType.Ragdoll
					or newState == Enum.HumanoidStateType.FallingDown
					or newState == Enum.HumanoidStateType.PlatformStanding then
					hum.PlatformStand = false
					hum.Sit = false
					hum:ChangeState(Enum.HumanoidStateType.Running)
				end
			end
		end))
		track(hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
			if state.AntiBat and hum.PlatformStand then
				hum.PlatformStand = false
			end
		end))
		track(hum:GetPropertyChangedSignal("Sit"):Connect(function()
			if state.AntiBat and hum.Sit then
				hum.Sit = false
			end
		end))
	end
	track(char.DescendantAdded:Connect(function(descendant)
		if state.AntiBat then
			if descendant:IsA("BallSocketConstraint") or (descendant:IsA("Attachment") and descendant.Name:find("RagdollAttachment")) then
				task.defer(function()
					pcall(function() descendant:Destroy() end)
				end)
			elseif descendant:IsA("Motor6D") and not descendant.Enabled then
				descendant.Enabled = true
			end
		end
	end))
end

track(LocalPlayer:GetAttributeChangedSignal("RagdollEndTime"):Connect(function()
	if state.AntiBat then
		pcall(function()
			LocalPlayer:SetAttribute("RagdollEndTime", workspace:GetServerTimeNow())
		end)
	end
end))

track(RunService.Stepped:Connect(function()
	if not state.AntiBat then return end
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 then
		if hum.PlatformStand then hum.PlatformStand = false end
		if hum.Sit then hum.Sit = false end
	end
end))

if LocalPlayer.Character then
	hookCharacter(LocalPlayer.Character)
end
track(LocalPlayer.CharacterAdded:Connect(function(newChar)
	currentBrainrotPart = nil
	currentCarryWeld = nil
	task.wait(0.2)
	hookCharacter(newChar)
end))

local OFF_POS = Vector3.new(0, -1000, 0)
local ijPlatform = Instance.new("Part")
ijPlatform.Name = "InfJumpPlatform"
ijPlatform.Size = Vector3.new(8, 0.5, 8)
ijPlatform.Anchored = true
ijPlatform.CanCollide = true
ijPlatform.Transparency = 1
ijPlatform.Material = Enum.Material.ForceField
ijPlatform.Position = OFF_POS
ijPlatform.Parent = workspace

local function infJumpStep()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (state.InfJump and root and hum) then
		ijPlatform.Position = OFF_POS
		return
	end
	local jumping = UserInputService:IsKeyDown(Enum.KeyCode.Space)
		or hum:GetState() == Enum.HumanoidStateType.Jumping
		or hum.Jump
	if jumping then
		ijPlatform.Position = root.Position - Vector3.new(0, 3.5, 0)
		local v = root.AssemblyLinearVelocity
		if v.Y < INF_JUMP_SPEED then
			root.AssemblyLinearVelocity = Vector3.new(v.X, INF_JUMP_SPEED, v.Z)
		end
	else
		ijPlatform.Position = OFF_POS
	end
end

local refreshToggles 

track(RunService.Heartbeat:Connect(antiBatStep))
track(RunService.Heartbeat:Connect(antiRagdollStep))
track(RunService.Heartbeat:Connect(infJumpStep))

