	Padding = UDim.new(0, 10),
	HorizontalAlignment = Enum.HorizontalAlignment.Center,
	SortOrder = Enum.SortOrder.LayoutOrder,
}, ThemeScroll)
new("UIPadding", { PaddingBottom = UDim.new(0, 10) }, ThemeScroll)

local function setScale(pct)
	pct = math.clamp(math.round(pct), SLIDER_MIN, SLIDER_MAX)
	state.Scale = pct
	PanelScale.Scale = pct / 100
	ScaleVal.Text = pct .. "%"
    saveSettings()
end

SizeMinusBtn.MouseButton1Click:Connect(function() setScale(state.Scale - 5) end)
SizePlusBtn.MouseButton1Click:Connect(function() setScale(state.Scale + 5) end)

local function setOpacity(pct)
	pct = math.clamp(math.round(pct), 0, 100)
	state.Opacity = pct
	OpacityVal.Text = pct .. "%"
	BgImage.ImageTransparency = 1 - (pct / 100)
    Shade.BackgroundTransparency = 0.32 + (pct / 100) * 0.68
    saveSettings()
end

OpacityMinusBtn.MouseButton1Click:Connect(function() setOpacity(state.Opacity - 5) end)
OpacityPlusBtn.MouseButton1Click:Connect(function() setOpacity(state.Opacity + 5) end)

local function refreshPages()
    if isMinimized then return end
    
	MainPage.Visible = (currentPage == "Main")
	SettingsPage.Visible = (currentPage == "Settings")
    ThemePage.Visible = (currentPage == "Themes")
    
	if currentPage == "Main" then
		GearBtn.TextColor3 = WHITE
        TweenService:Create(Panel, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(0, 250, 0, 190)}):Play()
	elseif currentPage == "Settings" then
		GearBtn.TextColor3 = VIPER
        TweenService:Create(Panel, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(0, 250, 0, 246)}):Play()
    elseif currentPage == "Themes" then
        GearBtn.TextColor3 = VIPER
        TweenService:Create(Panel, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(0, 250, 0, 246)}):Play()
    end
end

MinBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        MinBtn.TextColor3 = VIPER
        TweenService:Create(Panel, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(0, 250, 0, 36)}):Play()
    else
        MinBtn.TextColor3 = WHITE
        refreshPages()
    end
end)

GearBtn.MouseButton1Click:Connect(function()
    if isMinimized then
        isMinimized = false
        MinBtn.TextColor3 = WHITE
    end
    if currentPage == "Main" then
        currentPage = "Settings"
    else
        currentPage = "Main"
    end
	refreshPages()
end)

ChangeThemeBtn.MouseButton1Click:Connect(function()
    currentPage = "Themes"
    refreshPages()
end)

ThemeBackBtn.MouseButton1Click:Connect(function()
    currentPage = "Settings"
    refreshPages()
end)

local function setTheme(t)
    currentPage = "Settings"
    refreshPages()
	local cloneBg = BgImage:Clone()
	cloneBg.ZIndex = BgImage.ZIndex + 1
	cloneBg.Image = t.image
	cloneBg.ImageTransparency = 1
	cloneBg.Parent = Panel
	
	local targetTransparency = 1 - (state.Opacity / 100)
	local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Linear)
	local fadeTween = TweenService:Create(cloneBg, tweenInfo, { ImageTransparency = targetTransparency })
	fadeTween:Play()
	
	fadeTween.Completed:Connect(function()
		BgImage.Image = t.image
		BgImage.ImageTransparency = targetTransparency
        DEFAULT_BG = t.image
        saveSettings()
		cloneBg:Destroy()
	end)
end

for i, t in ipairs(THEMES) do
	local card = new("TextButton", {
		Name = t.name .. "ThemeCard",
		BackgroundColor3 = BTN,
		BorderSizePixel = 0,
		LayoutOrder = i,
		Size = UDim2.new(1, -12, 0, 48),
		ZIndex = 53,
		AutoButtonColor = false,
		Text = "",
		ClipsDescendants = true,
	}, ThemeScroll)
	corner(card, 8)

	local cardBg = new("ImageLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 54,
		Image = t.image,
		ImageTransparency = 0, 
		ScaleType = Enum.ScaleType.Crop,
	}, card)
	corner(cardBg, 8)

	card.MouseButton1Click:Connect(function()
		setTheme(t)
	end)
end

local function refreshToggle(btn, baseText, on)
	btn.Text = baseText .. " • " .. (on and "ON" or "OFF")
	btn.TextColor3 = on and WHITE or Color3.fromRGB(200, 200, 200)
	local s = btn:FindFirstChildOfClass("UIStroke")
	if s then
		s.Color = on and VIPER or Color3.fromRGB(60, 60, 90)
	end
end

refreshToggles = function()
	refreshToggle(AntiBatBtn, "Anti Bat", state.AntiBat)
	refreshToggle(InfJumpBtn, "Infinite Jump", state.InfJump)
	KeyBtn.Text = bindingKey and "..." or (antiTpKey and antiTpKey.Name or "NONE")
end

AntiBatBtn.MouseButton1Click:Connect(function()
	state.AntiBat = not state.AntiBat
	refreshToggles()
end)
InfJumpBtn.MouseButton1Click:Connect(function()
	state.InfJump = not state.InfJump
	refreshToggles()
end)

KeyBtn.MouseButton1Click:Connect(function()
	if bindingKey then return end
	bindingKey = true
	refreshToggles()
end)

track(UserInputService.InputBegan:Connect(function(input, gp)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if bindingKey then
        if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Escape then
            antiTpKey = nil 
        elseif input.KeyCode ~= Enum.KeyCode.Unknown then
			antiTpKey = input.KeyCode
		end
		bindingKey = false
        saveSettings()
		refreshToggles()
		return
	end
	if not gp and antiTpKey and input.KeyCode == antiTpKey then
		state.AntiBat = not state.AntiBat
		refreshToggles()
	end
end))

local dragging = false
local dragStart, startPos

Header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = Panel.Position
	end
end)

track(UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	if dragging then
		local d = input.Position - dragStart
		Panel.Position = UDim2.new(0, startPos.X.Offset + d.X, 0, startPos.Y.Offset + d.Y)
	end
end))

track(UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end))

setScale(state.Scale)
setOpacity(state.Opacity)
refreshPages()
refreshToggles()

runtime.destroy = function()
	runtime.alive = false
	for _, c in ipairs(conns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(conns)
	pcall(function() ijPlatform:Destroy() end)
	pcall(function() Gui:Destroy() end)
	if env.__VIPER_NEBULA_ANTIBAT_RUNTIME == runtime then
		env.__VIPER_NEBULA_ANTIBAT_RUNTIME = nil
	end
end

return Gui
